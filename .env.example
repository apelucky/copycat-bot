# Required
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=            # comma-separated Telegram numeric user ids (empty = anyone can use the bot!)
# Strongly recommended
HELIUS_API_KEY=              # Solana wallet streaming (without it: public RPC, rate-limited)
# Optional
RPC_URL_BASE=                # e.g. Alchemy/QuickNode URL; default public RPCs with failover
RPC_URL_ETHEREUM=
RPC_URL_BSC=
RPC_URL_ROBINHOOD=
RPC_URL_SOLANA=
ETHERSCAN_API_KEY=           # EVM funding-source lookups (Etherscan v2 multichain)
X_BEARER_TOKEN=              # X API v2 recent search for Group Buy mention checks
XAI_API_KEY=                 # optional Grok advisor (advisory only)
XAI_MODEL=grok-4
TZ=Africa/Lagos
# Leave DATABASE_URL empty on your laptop (SQLite file below). On Render, set it to the
# Supabase pooler URI — see DEPLOY_RENDER.md. Render sets PORT itself; do not set it here.
DATABASE_URL=
DB_PATH=copycat.db
ENABLED_CHAINS=              # e.g. solana,base  (empty = all chains whose providers work)
POLL_SECONDS=25
TRACKED_TOP_N=15
LEADERBOARD_REFRESH_MINUTES=360
MORNING_REPORT_HOUR=9
